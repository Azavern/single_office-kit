# Environment for agent-kit (copy to a real .env or export directly)
# NEVER put a real token in this file. The token comes from the Secure
# Vault (Q-07) and lives in ~/.config/single-office/<agent>-token (mode 600).

# Agent identity — REQUIRED. Lowercase slug, e.g. finch.
# Drives the service name (<agent>-side), the default token file and
# the default push-secret file. The daemon fails fast without it.
OFFICE_AGENT_NAME=finch

# Office base URL (default: https://office.sailox.my.id)
OFFICE_BASE_URL=https://office.sailox.my.id

# One-time office token (env alternative to the token file).
# Leave empty in normal use — the token file is preferred.
OFFICE_AGENT_TOKEN=

# Token file location (default: ~/.config/single-office/<agent>-token)
# OFFICE_TOKEN_FILE=~/.config/single-office/finch-token

# Push secret (optional; only needed if a public push URL ever exists).
# File alternative: ~/.config/single-office/<agent>-push-secret (mode 600).
# OFFICE_PUSH_SECRET=

# Local daemon HTTP port (default: 8789). The watchdog hook takes the
# port as an argument — if you change this, pass the same port when
# registering the hook (see SETUP.md).
AGENT_LOCAL_PORT=8789

# Push signature skew tolerance in seconds (default: 300)
# PUSH_SKEW_SECONDS=300

# WS reconnect backoff in ms (defaults: base 1000, max 60000)
# WS_RECONNECT_BASE_MS=1000
# WS_RECONNECT_MAX_MS=60000
